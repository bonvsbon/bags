# --- Database ---
# Local dev (default): SQLite file in backend/
DATABASE_URL=sqlite:///./ngernthon.db
# Production (Neon / managed Postgres) — switch by uncommenting:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Google OAuth (Phase 1, optional) ---
GOOGLE_CLIENT_ID=

# --- CORS ---
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Background jobs ---
# Set true in production to run APScheduler (bill reminders, budget alerts, etc.)
ENABLE_SCHEDULER=false
