# --- Database ---
# Local dev (default): SQLite file in backend/
DATABASE_URL=sqlite:///./ngernthon.db
# Production (Neon / managed Postgres) — switch by uncommenting:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Google OAuth (Phase 1, optional) ---
GOOGLE_CLIENT_ID=

# --- CORS ---
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Background jobs ---
# Set true in production to run APScheduler (bill reminders, budget alerts, etc.)
ENABLE_SCHEDULER=false

# --- AI (Phase 9) ---
# Provider pools (comma-separated). A provider with no key is skipped, so you
# only run what you've signed up for. Order = failover priority.
AI_FREE_CHAIN=gemini,groq,openrouter,cerebras
AI_PAID_CHAIN=
# Hard gate: free users never reach paid providers. Turn on only with a paid plan.
AI_ALLOW_PAID=false
# Per-user free message cap per day (enforced in Phase 9.6)
AI_DAILY_MESSAGE_LIMIT=20
# Provider API keys — fill in what you have (start with Gemini, free at AI Studio)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
